@model List<AracServisTakipSistemi.Entities.Entities.Bolge>
@{
    ViewData["Title"] = "Bölgeler";
    var semtler = ViewBag.Semtler as List<AracServisTakipSistemi.Entities.Entities.SemtReferans>;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Bölgeler</h2>
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#ekleModal">+ Yeni Bölge</button>
</div>

@if (TempData["Basari"] != null)
{
    <div class="alert alert-success">@TempData["Basari"]</div>
}
@if (TempData["Hata"] != null)
{
    <div class="alert alert-danger">@TempData["Hata"]</div>
}

@if (semtler == null || !semtler.Any())
{
    <div class="alert alert-warning">
        Henüz hiç semt referansı tanımlanmamış. Koordinatı elle girebilirsiniz, ya da önce Semt Referansları ekranından birkaç semt tanımlayın.
    </div>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>Bölge Kodu</th>
            <th>Bölge Adı</th>
            <th>Merkez Koordinat</th>
            <th>Min. Personel Eşiği</th>
            <th>Kapasite Tamponu</th>
            <th>Durum</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var bolge in Model)
        {
            <tr>
                <td>@bolge.BolgeKodu</td>
                <td>@bolge.BolgeAdi</td>
                <td>
                    @if (bolge.MerkezEnlem.HasValue && bolge.MerkezBoylam.HasValue)
                    {
                        @($"{bolge.MerkezEnlem:F5}, {bolge.MerkezBoylam:F5}")
                    }
                    else
                    {
                        <span class="text-muted">Tanımlı değil</span>
                    }
                </td>
                <td>@bolge.MinPersonelEsigi</td>
                <td>@bolge.KapasiteTamponu</td>
                <td>
                    @if (bolge.AktifMi)
                    {
                        <span class="badge bg-success">Aktif</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Pasif</span>
                    }
                </td>
                <td>
                    <button type="button" class="btn btn-sm btn-outline-primary"
                            data-bs-toggle="modal" data-bs-target="#duzenleModal"
                            data-id="@bolge.Id"
                            data-kod="@bolge.BolgeKodu"
                            data-ad="@bolge.BolgeAdi"
                            data-enlem="@bolge.MerkezEnlem"
                            data-boylam="@bolge.MerkezBoylam"
                            data-esik="@bolge.MinPersonelEsigi"
                            data-tampon="@bolge.KapasiteTamponu"
                            data-aciklama="@bolge.Aciklama"
                            data-aktif="@bolge.AktifMi.ToString().ToLower()">
                        Düzenle
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary btn-durum-degistir" data-kid="@bolge.Id">
                        @(bolge.AktifMi ? "Pasife Al" : "Aktif Et")
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-danger"
                            data-bs-toggle="modal" data-bs-target="#silModal"
                            data-kid="@bolge.Id" data-ad="@bolge.BolgeAdi">
                        Sil
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="text-muted">Henüz bölge eklenmemiş.</p>
}

<!-- Ekle Modal -->
<div class="modal fade" id="ekleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Create" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Yeni Bölge Ekle</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label">Bölge Kodu</label>
                    <input class="form-control" type="text" name="BolgeKodu" placeholder="örn. BSK-01" /><br />

                    <label class="form-label">Bölge Adı</label>
                    <input class="form-control" type="text" name="BolgeAdi" placeholder="örn. Başakşehir Bölgesi" /><br />

                    @if (semtler != null && semtler.Any())
                    {
                        <label class="form-label">Semtten Koordinat Doldur (isteğe bağlı)</label>
                        <select class="form-select mb-2" id="ekle-semtSecim">
                            <option value="">-- Semt seçin --</option>
                            @foreach (var semt in semtler)
                            {
                                <option value="@semt.Id">@semt.SemtAdi</option>
                            }
                        </select>
                    }

                    <label class="form-label">Merkez Enlem</label>
                    <input class="form-control" type="number" step="0.000001" id="ekle-enlem" name="MerkezEnlem" /><br />

                    <label class="form-label">Merkez Boylam</label>
                    <input class="form-control" type="number" step="0.000001" id="ekle-boylam" name="MerkezBoylam" /><br />

                    <label class="form-label">Minimum Personel Eşiği</label>
                    <input class="form-control" type="number" name="MinPersonelEsigi" value="15" /><br />

                    <label class="form-label">Kapasite Tamponu</label>
                    <input class="form-control" type="number" name="KapasiteTamponu" value="5" /><br />

                    <label class="form-label">Açıklama</label>
                    <textarea class="form-control" name="Aciklama" rows="2"></textarea><br />

                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="AktifMi" value="true" checked />
                        <label class="form-check-label">Aktif</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-success">Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Düzenle Modal -->
<div class="modal fade" id="duzenleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Edit" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Bölge Düzenle</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="edit-Id" name="Id" />

                    <label class="form-label">Bölge Kodu</label>
                    <input class="form-control" type="text" id="edit-BolgeKodu" name="BolgeKodu" /><br />

                    <label class="form-label">Bölge Adı</label>
                    <input class="form-control" type="text" id="edit-BolgeAdi" name="BolgeAdi" /><br />

                    @if (semtler != null && semtler.Any())
                    {
                        <label class="form-label">Semtten Koordinat Doldur (isteğe bağlı)</label>
                        <select class="form-select mb-2" id="duzenle-semtSecim">
                            <option value="">-- Semt seçin --</option>
                            @foreach (var semt in semtler)
                            {
                                <option value="@semt.Id">@semt.SemtAdi</option>
                            }
                        </select>
                    }

                    <label class="form-label">Merkez Enlem</label>
                    <input class="form-control" type="number" step="0.000001" id="edit-MerkezEnlem" name="MerkezEnlem" /><br />

                    <label class="form-label">Merkez Boylam</label>
                    <input class="form-control" type="number" step="0.000001" id="edit-MerkezBoylam" name="MerkezBoylam" /><br />

                    <label class="form-label">Minimum Personel Eşiği</label>
                    <input class="form-control" type="number" id="edit-MinPersonelEsigi" name="MinPersonelEsigi" /><br />

                    <label class="form-label">Kapasite Tamponu</label>
                    <input class="form-control" type="number" id="edit-KapasiteTamponu" name="KapasiteTamponu" /><br />

                    <label class="form-label">Açıklama</label>
                    <textarea class="form-control" id="edit-Aciklama" name="Aciklama" rows="2"></textarea><br />

                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="edit-AktifMi" name="AktifMi" value="true" />
                        <label class="form-check-label">Aktif</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary">Güncelle</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Sil Onay Modal -->
<div class="modal fade" id="silModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Bölgeyi Sil</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p id="sil-mesaj"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">İptal</button>
                <button type="button" class="btn btn-danger" id="silOnaylaBtn">Evet, Sil</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Semtten koordinat doldurma — Ekle modal
        var ekleSemtSecim = document.getElementById('ekle-semtSecim');
        if (ekleSemtSecim) {
            ekleSemtSecim.addEventListener('change', function () {
                if (!this.value) return;
                $.get('/Bolge/SemtKoordinat', { semtId: this.value }, function (sonuc) {
                    if (sonuc.basarili) {
                        document.getElementById('ekle-enlem').value = sonuc.enlem;
                        document.getElementById('ekle-boylam').value = sonuc.boylam;
                    }
                });
            });
        }

        // Semtten koordinat doldurma — Düzenle modal
        var duzenleSemtSecim = document.getElementById('duzenle-semtSecim');
        if (duzenleSemtSecim) {
            duzenleSemtSecim.addEventListener('change', function () {
                if (!this.value) return;
                $.get('/Bolge/SemtKoordinat', { semtId: this.value }, function (sonuc) {
                    if (sonuc.basarili) {
                        document.getElementById('edit-MerkezEnlem').value = sonuc.enlem;
                        document.getElementById('edit-MerkezBoylam').value = sonuc.boylam;
                    }
                });
            });
        }

        // Düzenle butonuna basınca, o satırın data-* değerlerini modal'daki inputlara doldur
        document.querySelectorAll('[data-bs-target="#duzenleModal"]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                document.getElementById('edit-Id').value = btn.getAttribute('data-id');
                document.getElementById('edit-BolgeKodu').value = btn.getAttribute('data-kod');
                document.getElementById('edit-BolgeAdi').value = btn.getAttribute('data-ad');
                document.getElementById('edit-MerkezEnlem').value = btn.getAttribute('data-enlem') || '';
                document.getElementById('edit-MerkezBoylam').value = btn.getAttribute('data-boylam') || '';
                document.getElementById('edit-MinPersonelEsigi').value = btn.getAttribute('data-esik');
                document.getElementById('edit-KapasiteTamponu').value = btn.getAttribute('data-tampon');
                document.getElementById('edit-Aciklama').value = btn.getAttribute('data-aciklama') || '';
                document.getElementById('edit-AktifMi').checked = (btn.getAttribute('data-aktif') === 'true');
            });
        });

        // Durum değiştir — AJAX
        document.querySelectorAll('.btn-durum-degistir').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var id = btn.getAttribute('data-kid');
                $.ajax({
                    url: '/Bolge/DurumDegistir',
                    type: 'POST',
                    data: { id: id },
                    success: function (sonuc) {
                        if (sonuc === "başarılı") {
                            location.reload();
                        } else {
                            alert("Bir hata oluştu, tekrar deneyin.");
                        }
                    },
                    error: function () {
                        alert("Bir hata oluştu, tekrar deneyin.");
                    }
                });
            });
        });

        // Sil — onay modal'ı açılınca mesajı doldur, id'yi sakla
        var silinecekId = null;
        document.querySelectorAll('[data-bs-target="#silModal"]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                silinecekId = btn.getAttribute('data-kid');
                var ad = btn.getAttribute('data-ad');
                document.getElementById('sil-mesaj').innerText =
                    "'" + ad + "' bölgesini silmek istediğinize emin misiniz? Bu işlem geri alınamaz.";
            });
        });

        document.getElementById('silOnaylaBtn').addEventListener('click', function () {
            if (!silinecekId) return;

            $.ajax({
                url: '/Bolge/Sil',
                type: 'POST',
                data: { id: silinecekId },
                success: function (sonuc) {
                    if (sonuc === "başarılı") {
                        location.reload();
                    } else {
                        alert("Bu bölgeye bağlı personel veya rota olduğu için silinemedi. Önce onları taşıyın ya da 'Pasife Al' kullanın.");
                    }
                },
                error: function () {
                    alert("Bir hata oluştu, tekrar deneyin.");
                }
            });
        });
    </script>
}
