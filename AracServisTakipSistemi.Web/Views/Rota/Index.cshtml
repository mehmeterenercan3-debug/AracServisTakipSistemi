@using AracServisTakipSistemi.Web.Models
@model List<RotaViewModel>
@{
    ViewData["Title"] = "Rota Hesaplama ve Yönetimi";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Rota Hesaplama ve Yönetimi</h2>
    <form asp-action="YenidenHesapla" method="post" class="d-inline" id="yenidenHesaplaForm">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-primary" id="btnYenidenHesapla">
            Rotaları Yeniden Hesapla
        </button>
    </form>
</div>

@if (TempData["Basari"] != null)
{
    <div class="alert alert-success">@TempData["Basari"]</div>
}
@if (TempData["Hata"] != null)
{
    <div class="alert alert-danger">@TempData["Hata"]</div>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>#ID</th>
            <th>Araç Plaka</th>
            <th>Yön</th>
            <th>Mesafe (Km)</th>
            <th>Süre (Dk)</th>
            <th>Durum</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var rota in Model)
        {
            <tr id="rota-row-@rota.Id">
                <td>#@rota.Id</td>
                <td>@rota.AracPlaka</td>
                <td>
                    @if (rota.Yon == "Gidis")
                    {
                        <span class="badge bg-primary">Gidiş (Sabah)</span>
                    }
                    else
                    {
                        <span class="badge bg-dark">Dönüş (Akşam)</span>
                    }
                </td>
                <td>@rota.ToplamMesafeKm km</td>
                <td>@rota.TahminiSureDk dk</td>
                <td id="durum-badge-@rota.Id">
                    @if (rota.Durum == "Onaylandi")
                    {
                        <span class="badge bg-success">Onaylandı</span>
                    }
                    else
                    {
                        <span class="badge bg-info text-dark">Onay Bekliyor</span>
                    }
                </td>
                <td>
                    <button type="button" class="btn btn-sm btn-outline-primary btn-detay" data-kid="@rota.Id">
                        Detay
                    </button>
                    @if (rota.Durum != "Onaylandi")
                    {
                        <button type="button" class="btn btn-sm btn-outline-success btn-onayla" data-kid="@rota.Id">
                            Onayla
                        </button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="text-muted">Henüz hiç rota hesaplanmadı. "Rotaları Yeniden Hesapla" butonuna basarak başlayın.</p>
}

<!-- Detay Modal -->
<div class="modal fade" id="detayModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Rota Detayı</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="detayModalIcerik">
                <div class="text-center py-3">Yükleniyor...</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.btn-detay').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var id = btn.getAttribute('data-kid');
                document.getElementById('detayModalIcerik').innerHTML = '<div class="text-center py-3">Yükleniyor...</div>';

                var modal = new bootstrap.Modal(document.getElementById('detayModal'));
                modal.show();

                $.get('/Rota/DetayPartial', { id: id }, function (html) {
                    document.getElementById('detayModalIcerik').innerHTML = html;
                }).fail(function () {
                    document.getElementById('detayModalIcerik').innerHTML = '<div class="alert alert-danger">Detaylar yüklenirken bir hata oluştu.</div>';
                });
            });
        });

        document.getElementById('yenidenHesaplaForm').addEventListener('submit', async function (e) {
            e.preventDefault();
            var form = this;
            var onaylandi = await onayIste('Rotalar yeniden hesaplanacak, devam edilsin mi?');
            if (onaylandi) form.submit();
        });

        document.querySelectorAll('.btn-onayla').forEach(function (btn) {
            btn.addEventListener('click', async function () {
                var onaylandi = await onayIste('Bu rotayı onaylamak istediğinize emin misiniz?');
                if (!onaylandi) return;

                var id = btn.getAttribute('data-kid');
                $.ajax({
                    url: '/Rota/Onayla',
                    type: 'POST',
                    data: { id: id },
                    success: function (sonuc) {
                        if (sonuc === "başarılı") {
                            location.reload();
                        } else {
                            mesajGoster("Bir hata oluştu, tekrar deneyin.", 'hata');
                        }
                    },
                    error: function () {
                        mesajGoster("Bir hata oluştu, tekrar deneyin.", 'hata');
                    }
                });
            });
        });
    </script>
}