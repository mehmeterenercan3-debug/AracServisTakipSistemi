<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Araç Servis Takip Sistemi</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AracServisTakipSistemi.Web.styles.css" asp-append-version="true" />
    <style>
        body {
            background-color: #f4f6f9;
        }

        .app-sidebar {
            min-height: 100vh;
            background-color: #1e2a3a;
            width: 230px;
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            padding-top: 1rem;
            z-index: 100;
        }

            .app-sidebar .brand {
                color: #fff;
                font-weight: 600;
                font-size: 1.05rem;
                padding: 0.5rem 1.25rem 1.25rem;
                display: block;
                border-bottom: 1px solid rgba(255,255,255,0.1);
                margin-bottom: 0.5rem;
            }

            .app-sidebar .nav-link {
                color: rgba(255,255,255,0.75);
                padding: 0.6rem 1.25rem;
                font-size: 0.92rem;
                display: flex;
                align-items: center;
                gap: 0.6rem;
            }

                .app-sidebar .nav-link:hover {
                    color: #fff;
                    background-color: rgba(255,255,255,0.06);
                }

                .app-sidebar .nav-link.active {
                    color: #fff;
                    background-color: #2f6fed;
                    border-radius: 6px;
                    margin: 0 0.5rem;
                    padding-left: 0.75rem;
                    width: calc(100% - 1rem);
                }

        .app-content {
            margin-left: 230px;
        }

        .app-topbar {
            background: #fff;
            border-bottom: 1px solid #e5e7eb;
            padding: 0.7rem 1.5rem;
            display: flex;
            justify-content: flex-end;
            align-items: center;
            gap: 1rem;
        }

        /* Şoför/Personel gibi kenar çubuğu olmayan roller için markalı, koyu üst bar */
        .app-topbar-branded {
            background: #1e2a3a;
            padding: 0.85rem 1.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 1rem;
            color: #fff;
        }

            .app-topbar-branded .brand {
                color: #fff;
                font-weight: 600;
                font-size: 1.05rem;
                text-decoration: none;
                display: flex;
                align-items: center;
                gap: 0.5rem;
            }

            .app-topbar-branded .text-muted {
                color: rgba(255,255,255,0.75) !important;
            }

        .app-main {
            padding: 1.75rem;
        }

        /* Genel görsel cila — kart ve tablo alanları için */
        .card {
            border: none;
            border-radius: 10px;
            box-shadow: 0 1px 4px rgba(0,0,0,0.06);
        }

        .table {
            background-color: #fff;
            border-radius: 8px;
            overflow: hidden;
        }

            .table thead th {
                background-color: #f1f3f6;
                border-bottom: 2px solid #e5e7eb;
                font-weight: 600;
                font-size: 0.85rem;
                text-transform: uppercase;
                letter-spacing: 0.02em;
                color: #4b5563;
            }

        h2 {
            font-weight: 600;
            color: #1e2a3a;
        }

        .btn {
            border-radius: 6px;
        }

        .badge {
            font-weight: 500;
            padding: 0.4em 0.7em;
        }

        @@media (max-width: 768px) {
            .app-sidebar {
                display: none;
            }

            .app-content {
                margin-left: 0;
            }
        }
    </style>
</head>
<body>
    @{
        bool girisliVeAdmin = User.Identity?.IsAuthenticated == true && User.IsInRole("Admin");
        bool girisliVeDiger = User.Identity?.IsAuthenticated == true && !girisliVeAdmin;
    }
    @if (girisliVeAdmin)
    {
        <nav class="app-sidebar">
            <a class="brand" asp-controller="Admin" asp-action="Index">
                <i class="bi bi-truck"></i> Araç Servis Takip
            </a>
            <ul class="nav flex-column">
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" ? "active" : "")" asp-controller="Admin" asp-action="Index">
                        <i class="bi bi-speedometer2"></i> Panel
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Personel" ? "active" : "")" asp-controller="Personel" asp-action="Index">
                        <i class="bi bi-people"></i> Personel
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Arac" ? "active" : "")" asp-controller="Arac" asp-action="Index">
                        <i class="bi bi-truck-front"></i> Araçlar
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Bolge" ? "active" : "")" asp-controller="Bolge" asp-action="Index">
                        <i class="bi bi-geo-alt"></i> Bölgeler
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Vardiya" ? "active" : "")" asp-controller="Vardiya" asp-action="Index">
                        <i class="bi bi-clock"></i> Vardiyalar
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Rota" ? "active" : "")" asp-controller="Rota" asp-action="Index">
                        <i class="bi bi-signpost-split"></i> Rota Hesaplama
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "BekleyenPersonel" ? "active" : "")" asp-controller="BekleyenPersonel" asp-action="Index">
                        <i class="bi bi-exclamation-triangle"></i> Bekleyen Personel
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Ayarlar" ? "active" : "")" asp-controller="Ayarlar" asp-action="Index">
                        <i class="bi bi-gear"></i> Ayarlar
                    </a>
                </li>
            </ul>
        </nav>
    }
    <div class="@(girisliVeAdmin ? "app-content" : "")">
        @if (girisliVeDiger)
        {
            <div class="app-topbar-branded">
                <a class="brand" asp-controller="Servisim" asp-action="Index">
                    <i class="bi bi-truck"></i> Araç Servis Takip
                </a>
                <div class="d-flex align-items-center gap-3">
                    <span class="text-muted"><i class="bi bi-person-circle"></i> @User.Identity!.Name</span>
                    <form asp-controller="Hesap" asp-action="Cikis" method="post" class="m-0">
                        <button type="submit" class="btn btn-sm btn-outline-light">Çıkış Yap</button>
                    </form>
                </div>
            </div>
        }
        else
        {
            <div class="app-topbar">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="text-muted"><i class="bi bi-person-circle"></i> @User.Identity.Name</span>
                    <form asp-controller="Hesap" asp-action="Cikis" method="post" class="m-0">
                        <button type="submit" class="btn btn-sm btn-outline-secondary">Çıkış Yap</button>
                    </form>
                }
                else
                {
                    <a class="btn btn-sm btn-primary" asp-controller="Hesap" asp-action="Giris">Giriş Yap</a>
                }
            </div>
        }
        <main class="app-main">
            @RenderBody()
        </main>
    </div>
    <div class="toast-container position-fixed top-0 end-0 p-3" id="toastContainer" style="z-index: 1080;"></div>

    <div class="modal fade" id="onayModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-question-circle text-primary"></i> Onay</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" id="onayModalMesaj"></div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Vazgeç</button>
                    <button type="button" class="btn btn-primary" id="onayModalOnayla">Onayla</button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        // alert() yerine — şık, kendi tasarımımızla uyumlu bildirim kutusu (sağ üstte çıkar, otomatik kaybolur)
        function mesajGoster(mesaj, tur) {
            tur = tur || 'bilgi';
            var renkler = { basari: 'bg-success text-white', hata: 'bg-danger text-white', bilgi: 'bg-primary text-white' };
            var sinif = renkler[tur] || renkler.bilgi;

            var toastEl = document.createElement('div');
            toastEl.className = 'toast align-items-center ' + sinif + ' border-0';
            toastEl.setAttribute('role', 'alert');
            toastEl.innerHTML =
                '<div class="d-flex">' +
                    '<div class="toast-body" style="white-space: pre-line;">' + mesaj + '</div>' +
                    '<button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>' +
                '</div>';

            document.getElementById('toastContainer').appendChild(toastEl);
            var toast = new bootstrap.Toast(toastEl, { delay: 7000 });
            toast.show();
            toastEl.addEventListener('hidden.bs.toast', function () { toastEl.remove(); });
        }

        // confirm() yerine — kendi tasarımımızla uyumlu onay modalı, Promise döndürür
        function onayIste(mesaj) {
            return new Promise(function (resolve) {
                document.getElementById('onayModalMesaj').innerText = mesaj;
                var modalEl = document.getElementById('onayModal');
                var modal = new bootstrap.Modal(modalEl);
                var onaylaBtn = document.getElementById('onayModalOnayla');

                function temizle() {
                    onaylaBtn.removeEventListener('click', onaylaHandler);
                    modalEl.removeEventListener('hidden.bs.modal', iptalHandler);
                }
                function onaylaHandler() {
                    temizle();
                    modal.hide();
                    resolve(true);
                }
                function iptalHandler() {
                    temizle();
                    resolve(false);
                }

                onaylaBtn.addEventListener('click', onaylaHandler);
                modalEl.addEventListener('hidden.bs.modal', iptalHandler);
                modal.show();
            });
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
