@model AracServisTakipSistemi.Web.Models.SifreDegistirViewModel
@{
    ViewData["Title"] = "Şifremi Değiştir";
}

<h2>Şifremi Değiştir</h2>

<form asp-action="SifreDegistir" method="post" class="mt-3" style="max-width: 400px;">
    <div asp-validation-summary="All" class="text-danger mb-2"></div>

    <div class="mb-3">
        <label asp-for="MevcutSifre" class="form-label"></label>
        <input asp-for="MevcutSifre" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="YeniSifre" class="form-label"></label>
        <input asp-for="YeniSifre" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="YeniSifreTekrar" class="form-label"></label>
        <input asp-for="YeniSifreTekrar" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Şifreyi Değiştir</button>
    <a asp-controller="Servisim" asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
</form>
