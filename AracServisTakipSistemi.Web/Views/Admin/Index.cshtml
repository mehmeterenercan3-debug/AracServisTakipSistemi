@model AracServisTakipSistemi.Web.Models.AdminDashboardViewModel
@{
    ViewData["Title"] = "Yönetim Paneli";
}

<h2>Yönetim Paneli</h2>

<div class="row mt-4">
    <div class="col-md-3 mb-3">
        <div class="card text-white bg-primary">
            <div class="card-body">
                <h5 class="card-title">Aktif Personel</h5>
                <p class="card-text fs-3">@Model.ToplamAktifPersonel</p>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card text-white bg-warning">
            <div class="card-body">
                <h5 class="card-title">Beklemede Kalan Personel</h5>
                <p class="card-text fs-3">@Model.BeklemedeKalanPersonel</p>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card text-white bg-success">
            <div class="card-body">
                <h5 class="card-title">Aktif Araç</h5>
                <p class="card-text fs-3">@Model.ToplamAktifArac</p>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card text-white bg-danger">
            <div class="card-body">
                <h5 class="card-title">Bakımdaki Araç</h5>
                <p class="card-text fs-3">@Model.BakimdakiAracSayisi</p>
            </div>
        </div>
    </div>
</div>

<div class="row mt-3">
    <div class="col-md-2 mb-2"><a class="btn btn-outline-primary w-100" asp-controller="Personel" asp-action="Index">Personel Yönetimi</a></div>
    <div class="col-md-2 mb-2"><a class="btn btn-outline-primary w-100" asp-controller="Arac" asp-action="Index">Araç Yönetimi</a></div>
    <div class="col-md-2 mb-2"><a class="btn btn-outline-primary w-100" asp-controller="Bolge" asp-action="Index">Bölge Yönetimi</a></div>
    <div class="col-md-2 mb-2"><a class="btn btn-outline-primary w-100" asp-controller="Vardiya" asp-action="Index">Vardiya Yönetimi</a></div>
    <div class="col-md-2 mb-2"><a class="btn btn-outline-primary w-100" asp-controller="Rota" asp-action="Index">Rotalar</a></div>
    <div class="col-md-2 mb-2"><a class="btn btn-outline-warning w-100" asp-controller="BekleyenPersonel" asp-action="Index">Bekleyen Personel</a></div>
</div>

<div class="row mt-4">
    <div class="col-md-6 mb-3">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Son 30 Günde Risk Skoru Dağılımı</h5>
                @if (Model.RiskDagilimi.Sum(v => v.Deger) == 0)
                {
                    <p class="text-muted mb-0">Son 30 günde hesaplanmış bir risk skoru yok.</p>
                }
                else
                {
                    <div style="max-width: 260px; height: 220px; margin: 0 auto;">
                        <canvas id="riskGrafik"></canvas>
                    </div>

                    <hr />
                    <h6 class="text-muted">Hangi Araç? — Aracın Güncel Risk Durumu</h6>
                    <table class="table table-sm table-striped mb-0">
                        <thead>
                            <tr><th>Plaka</th><th>Seviye</th><th>Puan</th><th>Tarih</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var detay in Model.SonRiskHesaplamalari)
                            {
                                var rozetSinif = detay.Seviye switch
                                {
                                    "Kritik" => "bg-danger",
                                    "Yüksek" => "bg-warning text-dark",
                                    "Orta" => "bg-info text-dark",
                                    _ => "bg-success"
                                };
                                <tr>
                                    <td>@detay.Plaka</td>
                                    <td><span class="badge @rozetSinif">@detay.Seviye</span></td>
                                    <td>@detay.Puan</td>
                                    <td>@detay.Tarih.ToString("dd.MM.yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
    <div class="col-md-6 mb-3">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Bölge Başına Personel Sayısı</h5>
                @if (!Model.BolgePersonelDagilimi.Any())
                {
                    <p class="text-muted mb-0">Henüz bölgeye atanmış personel yok.</p>
                }
                else
                {
                    <canvas id="bolgeGrafik" height="220"></canvas>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
    <script>
        // Risk dağılımı verisini, tooltip'te o seviyedeki plakaları da gösterecek şekilde hazırlıyoruz
        var riskDetaylari = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SonRiskHesaplamalari.Select(d => new { d.Plaka, d.Seviye })));

        var riskEtiketler = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RiskDagilimi.Select(v => v.Etiket)));
        var riskDegerler = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RiskDagilimi.Select(v => v.Deger)));

        var riskCanvas = document.getElementById('riskGrafik');
        if (riskCanvas) {
            new Chart(riskCanvas, {
                type: 'doughnut',
                data: {
                    labels: riskEtiketler,
                    datasets: [{
                        data: riskDegerler,
                        backgroundColor: ['#198754', '#0dcaf0', '#ffc107', '#dc3545']
                    }]
                },
                options: {
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom' },
                        tooltip: {
                            callbacks: {
                                label: function (context) {
                                    var seviye = context.label;
                                    var plakalar = riskDetaylari
                                        .filter(function (d) { return d.Seviye === seviye; })
                                        .map(function (d) { return d.Plaka; });
                                    var plakaMetni = plakalar.length > 0 ? plakalar.join(', ') : 'yok';
                                    return seviye + ': ' + context.parsed + ' araç (' + plakaMetni + ')';
                                }
                            }
                        }
                    }
                }
            });
        }

        var bolgeEtiketler = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.BolgePersonelDagilimi.Select(v => v.Etiket)));
        var bolgeDegerler = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.BolgePersonelDagilimi.Select(v => v.Deger)));

        var bolgeCanvas = document.getElementById('bolgeGrafik');
        if (bolgeCanvas) {
            new Chart(bolgeCanvas, {
                type: 'bar',
                data: {
                    labels: bolgeEtiketler,
                    datasets: [{
                        label: 'Personel Sayısı',
                        data: bolgeDegerler,
                        backgroundColor: '#2f6fed'
                    }]
                },
                options: {
                    plugins: { legend: { display: false } },
                    scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
                }
            });
        }
    </script>
}
